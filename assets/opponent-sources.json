  "recommendations": [
    {
      "name": "武器皮肤悬浮展示",
      "description": "以精致插画展示单一武器皮肤，背景配合少量特效。成本低，视觉干净，但类似商店展示，缺乏战斗氛围。",
      "pros": [
        "成本低",
        "制作快",
        "皮肤细节突出"
      ],
      "cons": [
        "像商店",
        "缺乏战斗感",
        "不利于表现对手特性"
      ]
    },
    {
      "name": "枪械+皮肤能量战斗形象",
      "description": "枪械主体与皮肤特效能量融合，构成战斗姿态，如扫描环、盾片、龙焰等。战斗感最强，每件武器都有独立剪影，适合作为对手形象。",
      "pros": [
        "战斗感强",
        "有独立剪影",
        "适合表现对手特性"
      ],
      "cons": [
        "制作成本中等",
        "需要平衡细节与简洁"
      ]
    },
    {
      "name": "五人武器阵列",
      "description": "五把武器排列成战队队形。战队主题强，但小屏下易杂乱，不推荐移动端使用。",
      "pros": [
        "战队感强",
        "展示多把武器"
      ],
      "cons": [
        "小屏杂乱",
        "每把武器细节不够",
        "识别度低"
      ]
    }
  ],
